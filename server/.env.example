# Configuration for the LiquidAlpha backend.
# Validated at startup by src/config/env.ts -- the process exits with a clear
# error listing what's missing/invalid rather than falling back to a silent
# default for anything required.

# Required

# PostgreSQL connection string. See
# https://www.postgresql.org/docs/current/libpq-connect.html for format.
DATABASE_URL=postgresql://user:password@localhost:5432/liquidalpha

# Secret used to sign session JWTs. Required, at least 32 characters, no
# default -- the server refuses to start without it rather than falling
# back to a hardcoded value.
JWT_SECRET=replace-with-a-long-random-value-at-least-32-chars

# Optional (defaults shown)

# HTTP server port.
PORT=3001

# WebSocket server port.
WS_PORT=8080

# Domain bound into the wallet-signature login message (SIWE-style). Must
# match wherever the client is actually served in each environment.
AUTH_DOMAIN=localhost:3001

# How long an issued login nonce stays valid before it must be re-requested.
NONCE_TTL_SECONDS=300

# How long a session (and its cookie) stays valid before re-authentication
# is required.
SESSION_TTL_DAYS=7

# Comma-separated list of allowed CORS origins. Unset falls back to common
# local-dev client ports (localhost:3000, localhost:5173). Never a wildcard.
CORS_ORIGIN=

# Hyperliquid API base URL and optional key for premium endpoints.
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_API_KEY=

# CoinGecko API key for higher rate limits. Leave unset to use the free tier.
COINGECKO_API_KEY=
